@startuml retrieve_layer_pipeline
title retrieve_layer: async L2 fetch pipelined with vLLM attention

participant "vLLM" as V
participant "LMCache\nretrieve_layer()" as L

L -> L : submit L0 fetch [async I/O]
L ->> V : yield ret_mask

activate V
V -> V : get hit token count\nprepare to receive L0
V -> L : next()
deactivate V

L -> L : task.result()\n← wait L0 fetch done
L -> L : send(L0 objs)\n← CPU→GPU copy
L -> L : submit L1 fetch [async I/O]
L ->> V : yield None

activate V
V -> V : use L0 KV for attention
V -> L : next()
deactivate V

L -> L : task.result()\n← wait L1 fetch done
L -> L : send(L1 objs)\n← CPU→GPU copy
L -> L : submit L2 fetch [async I/O]
L ->> V : yield None

activate V
V -> V : use L1 KV for attention
V -> L : next()
deactivate V

L -> L : task.result()\n← wait L2 fetch done
L -> L : send(L2 objs)\n← CPU→GPU copy

@enduml
