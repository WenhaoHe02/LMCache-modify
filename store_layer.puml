@startuml store_layer_pipeline
title store_layer: GPU→CPU copy pipelined with vLLM attention

participant "vLLM" as V
participant "LMCache\nstore_layer()" as L

note over L : alloc CPU mem (all layers)

L -> L : next(copy_gen)\n→ start L0 GPU→CPU [async]
L ->> V : yield

activate V
V -> V : compute L0 attention
V -> L : next()
deactivate V

L -> L : next(copy_gen)\n→ start L1 GPU→CPU [async]
L -> L : batched_put(L0)\n(wait L0 copy done, store to disk/remote)
L ->> V : yield

activate V
V -> V : compute L1 attention
V -> L : next()
deactivate V

L -> L : next(copy_gen)\n→ start L2 GPU→CPU [async]
L -> L : batched_put(L1)
L ->> V : yield

activate V
V -> V : compute L2 attention
V -> L : next()
deactivate V

L -> L : next(copy_gen) → sync / finalize
L -> L : batched_put(L2)

@enduml
